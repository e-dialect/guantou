COMPOSE_PROJECT_NAME=guantou

# Local ports
BACKEND_PORT=8000
FRONTEND_PORT=8181
# Empty means the H5 app calls same-origin resource paths through the frontend nginx proxy.
FRONTEND_BACKEND_URL=

# Image/container names
BACKEND_IMAGE=guantou-backend
BACKEND_CONTAINER=guantou-backend
FRONTEND_IMAGE=guantou-frontend
FRONTEND_CONTAINER=guantou-frontend

# Django/runtime secrets for local development
SECRET_KEY=dev-secret-key
JWT_KEY=dev-jwt-key

# Optional Tencent COS / WeChat / email settings
COS_SECRET_ID=DEFAULT_COS_SECRET_ID
COS_SECRET_KEY=DEFAULT_COS_SECRET_KEY
COS_BUCKET=DEFAULT_COS_BUCKET
COS_REGION=DEFAULT_COS_REGION
APP_ID=DEFAULT_APP_ID
# Preferred spelling. APP_SECRECT remains supported only for old local env files.
APP_SECRET=DEFAULT_APP_SECRET
WEB_APP_ID=DEFAULT_APP_ID
WEB_APP_SECRET=DEFAULT_APP_SECRET
EMAIL_HOST=DEFAULT_EMAIL_HOST
EMAIL_HOST_USER=DEFAULT_EMAIL_HOST_USER
EMAIL_HOST_PASSWORD=DEFAULT_EMAIL_HOST_PASSWORD
EMAIL_PORT=465
DEFAULT_FROM_EMAIL=DEFAULT_DEFAULT_FROM_EMAIL
